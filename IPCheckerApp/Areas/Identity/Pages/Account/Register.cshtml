@page
@model App.Mvc.Areas.Identity.Pages.Account.RegisterModel

@{
    ViewData["Title"] = "Register";
}

<div class="card border-primary mb-12">
    <div class="card-header card-header-custom">@ViewData["Title"] Form</div>
    <div class="card-body">
        <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
            <div class="row">
                <div class="col-md-12">
                    <div class="row mb-3 text-end">
                        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="row mb-3 text-end">
                        <label asp-for="Input.UserId" class="col-sm-4 col-form-label col-form-label-sm">User Id</label>
                        <div class="col-sm-8">
                            <input asp-for="Input.UserId" class="form-control form-control-sm" placeholder="a0123" autocomplete="username" aria-required="true" />
                        </div>
                    </div>
                    <div class="row mb-3 text-end">
                        <label asp-for="Input.Email" class="col-sm-4 col-form-label col-form-label-sm">Email</label>
                        <div class="col-sm-8">
                            <input asp-for="Input.Email" class="form-control form-control-sm" autocomplete="email" aria-required="true" />
                        </div>
                    </div>
                    <div class="row mb-3 text-end">
                        <label asp-for="Input.Password" class="col-sm-4 col-form-label col-form-label-sm">Password</label>
                        <div class="col-sm-8">
                            <input asp-for="Input.Password" class="form-control form-control-sm" type="password" autocomplete="new-password" aria-required="true" />
                        </div>
                    </div>
                    <div class="row mb-3 text-end">
                        <label asp-for="Input.ConfirmPassword" class="col-sm-4 col-form-label col-form-label-sm">Confirm Password</label>
                        <div class="col-sm-8">
                            <input asp-for="Input.ConfirmPassword" class="form-control form-control-sm" type="password" autocomplete="new-password" aria-required="true" />
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="offset-md-4 col-sm-8">
                            <button id="registerSubmit" type="submit" class="btn btn-primary btn-sm">Register</button>
                            @* <button id="btnSubmit" type="button" class="btn btn-primary btn-sm">Submit</button> *@
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                </div>
            </div>
        </form>


    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
