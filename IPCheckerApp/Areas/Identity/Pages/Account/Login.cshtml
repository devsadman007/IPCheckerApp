@page
@model App.Mvc.Areas.Identity.Pages.Account.LoginModel

@{
    ViewData["Title"] = "Log in";
    Layout = "_LogInLayout";
}

<br />
<br />
<br />
<br />


<div class="row">
    <div class="offset-md-3 col-md-6">
        <div class="card border-dark">
            <div class="card-header bg-primary text-white" data-bs-theme="dark"><h4>লগইন</h4></div>
            <div class="card-body">
                <form id="account" method="post">
                    <div asp-validation-summary="All" class="text-danger"></div>
                    <div class="form-group">
                        <label asp-for="Input.UserId">ইউজার আইডি</label>
                        <input asp-for="Input.UserId" class="form-control" style="border-color: steelblue" placeholder="User Id" />
                        <span asp-validation-for="Input.UserId" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="Input.Password">পাসওয়ার্ড</label>
                        <input asp-for="Input.Password" class="form-control" style="border-color: steelblue" placeholder="Password" />
                        <span asp-validation-for="Input.Password" class="text-danger"></span>
                    </div>
                    <div class="form-group" hidden>
                        <div class="checkbox">
                            <label asp-for="Input.RememberMe" style="color: black">
                                <input asp-for="Input.RememberMe" />
                                @Html.DisplayNameFor(m => m.Input.RememberMe)
                            </label>
                        </div>
                    </div>
                    <div class="form-group">
                        <button type="submit" class="btn btn-primary">লগইন</button>
                    </div>
                    @if (TempData["LoginSuccess"] != null)
                    {
                        <div id="successMessage" class="alert alert-success text-center">
                            @TempData["LoginSuccess"]
                        </div>
                    }
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const msg = document.getElementById('successMessage');
            if (msg) {
                setTimeout(() => {
                    msg.style.transition = 'opacity 0.5s ease';
                    msg.style.opacity = '0';
                    setTimeout(() => {
                        //console.log("Hi");
                        window.location.href = '/IpChecker/Index';
                    }, 500);
                }, 3000);
            }
        });
    </script>
}

