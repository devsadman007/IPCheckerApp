@model List<IPCheckerApp.Models.IpStatus>
@{
    ViewData["Title"] = "IP Results";
    var up = ViewBag.UpCount;
    var down = ViewBag.DownCount;
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>


<div class="container mt-5">
    <div class="card shadow">
        <div class="card-body">
            <h3 class="card-title text-center mb-3">📋 IP Check Results</h3>
            <p class="text-end text-muted">Checked at: <strong>@ViewBag.Timestamp</strong></p>

            <table class="table table-bordered table-striped">
                <thead class="table-dark">
                    <tr>
                        <th>SL</th>
                        <th>IP Address</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.SL</td>
                            <td>@item.IpAddress</td>
                            <td class="fw-bold text-@(item.Status == "UP" ? "success" : "danger")">@item.Status</td>
                        </tr>
                    }
                </tbody>
            </table>

            <div class="row mt-5">
                <div class="col-md-6">
                    <canvas id="pieChart"></canvas>
                </div>
                <div class="col-md-6">
                    <canvas id="barChart"></canvas>
                </div>
            </div>

            <div class="mt-4 text-center">
                <a class="btn btn-success me-2" href="@Url.Action("ExportCsv", "Export")">⬇ Export as CSV</a>
                <a class="btn btn-danger" href="@Url.Action("ExportPdf", "Export")" target="_blank">⬇ Export as PDF</a>
            </div>



            <div class="mt-4 text-center">
                <a href="@Url.Action("Index", "IpChecker")" class="btn btn-outline-primary">🔄 Check Again</a>
            </div>
        </div>
    </div>
</div>

<script>
    const upCount = @ViewBag.UpCount;
    const downCount = @ViewBag.DownCount;

    // Pie Chart
    new Chart(document.getElementById('pieChart'), {
        type: 'pie',
        data: {
            labels: ['UP', 'DOWN'],
            datasets: [{
                data: [upCount, downCount],
                backgroundColor: ['#28a745', '#dc3545'],
            }]
        },
        options: {
            plugins: {
                title: {
                    display: true,
                    text: 'IP Status Pie Chart',
                    font: { size: 18 }
                }
            }
        }
    });

    // Bar Chart
    new Chart(document.getElementById('barChart'), {
        type: 'bar',
        data: {
            labels: ['UP', 'DOWN'],
            datasets: [{
                label: 'IP Count',
                data: [upCount, downCount],
                backgroundColor: ['#28a745', '#dc3545']
            }]
        },
        options: {
            plugins: {
                title: {
                    display: true,
                    text: 'IP Status Bar Chart',
                    font: { size: 18 }
                }
            },
            scales: {
                y: {
                    beginAtZero: true,
                    precision: 0
                }
            }
        }
    });
</script>
