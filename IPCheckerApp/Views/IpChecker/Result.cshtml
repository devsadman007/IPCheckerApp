@model List<IPCheckerApp.Models.IpStatus>
@{
    ViewData["Title"] = "IP Results";
    var up = ViewBag.UpCount;
    var down = ViewBag.DownCount;
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>


<div class="container mt-5 mb-5">
    <div class="card shadow">
        <div class="card-body">
            <h3 class="card-title text-center mb-3"><i class="fa-solid fa-square-poll-vertical"></i>IP Check Results</h3>
            <p class="text-end text-muted">Checked at: <strong>@ViewBag.Timestamp</strong></p>

            <table class="table table-bordered table-striped">
                <thead class="table-info">
                    <tr>
                        <th>SL</th>
                        <th>IP Address</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.SL</td>
                            <td>@item.IpAddress</td>
                            <td class="fw-bold text-@(item.Status == "UP" ? "success" : "danger")">@item.Status</td>
                        </tr>
                    }
                </tbody>
            </table>

            <div class="card shadow-sm border-primary">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">IP Statistics Overview</h5>
                </div>
                <div class="row mb-4 mt-3">
                    <div class="col-md-6 offset-md-3">
                        <table class="table table-bordered text-center">
                            <thead class="table-info">
                                <tr>
                                    <th colspan="2">Summary</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td class="fw-bold text-success">Total UP</td>
                                    <td class="fw-bold">@ViewBag.UpCount</td>
                                </tr>
                                <tr>
                                    <td class="fw-bold text-danger">Total DOWN</td>
                                    <td class="fw-bold">@ViewBag.DownCount</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="card-body">
                    <div class="d-flex justify-content-center">
                        <div class="row">

                            <div class="col-md-6 text-center">
                                <canvas id="pieChart" width="300" height="300"></canvas>
                            </div>
                            <div class="col-md-6 text-center">
                                <canvas id="barChart" width="300" height="300"></canvas>
                            </div>
                        </div>
                   </div>
                </div>
            </div>


            <div class="mt-4 text-center">
                <a class="btn btn-success me-2" href="@Url.Action("ExportCsv", "Export")">
                    <i class="fa-solid fa-file-csv"></i> Export as CSV
                </a>

                <a class="btn btn-danger" href="@Url.Action("ExportPdf", "Export")" target="_blank"><i class="fa-solid fa-file-pdf"></i> Export as PDF</a>
            </div>



            <div class="mt-4 text-center">
                <a href="@Url.Action("Index", "IpChecker")" class="btn btn-outline-primary"><i class="fa-solid fa-rotate"></i> Check Again</a>
            </div>
        </div>
    </div>
</div>

<script>
    const upCount = @ViewBag.UpCount;
    const downCount = @ViewBag.DownCount;

    // Pie Chart
    new Chart(document.getElementById('pieChart'), {
        type: 'pie',
        data: {
            labels: ['UP', 'DOWN'],
            datasets: [{
                data: [upCount, downCount],
                backgroundColor: ['#28a745', '#dc3545'],
            }]
        },
        options: {
            maintainAspectRatio: false,
            plugins: {
                title: {
                    display: true,
                    text: 'IP Status Pie Chart',
                    font: { size: 18 }
                }
            }
        }
    });

    // Bar Chart
    new Chart(document.getElementById('barChart'), {
        type: 'bar',
        data: {
            labels: ['UP', 'DOWN'],
            datasets: [{
                label: 'IP Count',
                data: [upCount, downCount],
                backgroundColor: ['#28a745', '#dc3545']
            }]
        },
        options: {
            plugins: {
                title: {
                    display: true,
                    text: 'IP Status Bar Chart',
                    font: { size: 18 }
                }
            },
            scales: {
                y: {
                    beginAtZero: true,
                    precision: 0
                }
            }
        }
    });
</script>
