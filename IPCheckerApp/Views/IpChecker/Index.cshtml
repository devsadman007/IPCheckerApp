@{
    ViewData["Title"] = "IP Checker";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />

<div class="container mt-5">
    <div class="card shadow-lg">
        <div class="card-body">
            <h3 class="card-title mb-4 text-center"><i class="fa-solid fa-network-wired"></i> IP Address Status Checker</h3>

            <form asp-action="CheckIps" method="post" target="_blank">
                <div class="mb-3">
                    <label for="ipList" class="form-label">Enter IPs or Hostnames (one per line):</label>
                    <textarea class="form-control" id="ipList" name="ipList" rows="8" placeholder="e.g. 8.8.8.8&#10;example.com"></textarea>
                </div>
                <div class="text-center">
                    <button type="submit" class="btn btn-primary px-4">Check Status</button>
                </div>
            </form>
        </div>
    </div>
</div>
